{
    "name": "arghavan/workflow",
    "description": "ارغوان ورکفلو - پکیج محیط طراحی فرایند BPMN برای لاراول با bpmn.io (bpmn-js): المان شروع و پایان، تسک کاربری، اسکریپت تسک و گیت‌وی شرطی",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bpmn",
        "workflow",
        "bpmn-io",
        "bpmn-js",
        "modeler",
        "arghavan"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ArghavanWorkflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArghavanWorkflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArghavanWorkflow\\WorkflowServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
